index 0000000000000000000000000000000000000000..42f6f9933c168f38dc38a4c36234d0dd54ed2d9d
--- /dev/null
+++ b/src/jsonl/parser-pascal-shim.js
@@ -0,0 +1,10 @@
+// Case-preserving shim for consumers still importing the pre-3.x
+// PascalCase path (e.g. minio@8.0.7's notification.mjs does
+// `import jsonLineParser from 'stream-json/jsonl/Parser.js'`) — 3.x
+// renamed the file to lowercase `parser.js`. Exposed as an explicit
+// "./jsonl/Parser.js" entry in package.json's "exports" map (a plain
+// string-key lookup, so it works regardless of the filesystem's case
+// sensitivity) rather than as a same-named file next to `parser.js` —
+// Windows/macOS can't hold `Parser.js` and `parser.js` as distinct
+// files in the same directory.
+export { default, parser, jsonlParser } from './parser.js'
diff --git a/src/jsonl/stringer-pascal-shim.js b/src/jsonl/stringer-pascal-shim.js
